# Template for release signing.
#
# Copy this file to "keystore.properties" in the repository root and fill in the four values
# below. That copy is gitignored and must never be committed, nor may the .jks it points at.
# Without it the release build still runs, but produces an unsigned APK that cannot be
# installed on a device.
#
# Create the keystore once, storing it OUTSIDE this repository:
#
#   keytool -genkeypair -v -keystore juxtaposition-release.jks -alias juxt \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Back that file up permanently. Android identifies an app by its signing key, so losing it
# means no further updates can ever be shipped to anyone who already installed this app.
#
# NOTE: paths use forward slashes even on Windows. In a .properties file a backslash starts
# an escape sequence, so "C:\keys\app.jks" silently becomes an invalid path.

# Location of the keystore. Absolute, or relative to the repository root.
storeFile=C:/keys/juxtaposition-release.jks

# Password protecting the keystore file, set by keytool's first prompt.
storePassword=Belzer500

# Alias given to the key, matching the -alias argument used above.
keyAlias=juxt

# Password protecting that specific key. keytool allows this to equal storePassword.
keyPassword=Belzer500
