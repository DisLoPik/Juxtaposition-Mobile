// Set TEAM_ID to an Apple Developer team identifier to sign builds locally.
// Leaving it empty keeps unsigned simulator builds working, which is what CI uses.
TEAM_ID=

PRODUCT_NAME=Juxtaposition
PRODUCT_BUNDLE_IDENTIFIER=com.dislopik.juxtaposition

// Bump CURRENT_PROJECT_VERSION for every upload; MARKETING_VERSION is the public one.
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
